# Настройки бота «Лайт ПДД». Скопируй в .env и заполни: cp .env.example .env
# Файл .env в репозиторий НЕ попадает (он в .gitignore) — токен и ID храни только там.

# ===== Обязательно =====

# Токен бота от @BotFather. Нужен отдельный бот: один токен нельзя запускать в двух местах.
BOT_TOKEN=

# Telegram ID админов (узнать: @userinfobot), через запятую.
# Только им видна кнопка «🛠 Админка» и приходят уведомления о покупках.
ADMIN_IDS=

# ===== Имена (можно поменять и в боте: «🛠 Админка → ⚙️ Настройки») =====

# Название бота — подставляется в тексты вместо {bot_name}
BOT_NAME=Лайт ПДД
# Имя автора — в текстах «о себе» и «Информация» ({author})
AUTHOR_NAME=
# Username поддержки без @ — для кнопки «💬 Поддержка» и текстов. Пусто — «Поддержка скоро будет подключена»
MANAGER_USERNAME=

# ===== Каналы (добавим потом) =====
# Проще НЕ заполнять: добавь бота администратором в группу/канал — он сам спросит,
# что это за чат, и запомнит выбор. Эти поля — запасной вариант.

# Ссылка на Telegram-канал. В приветствии будут кнопки «Подписаться» и «Продолжить»
# (подписка НЕ обязательна). Пусто — кнопки канала не будет.
CHANNEL_URL=

# ID закрытой группы с разборами и чатом (начинается с -100). Бот выдаёт каждому купившему
# одноразовую ссылку. Пусто — бот скажет клиенту «пришлю ссылку позже», а тебе — что группа не настроена.
PRIVATE_CHANNEL_ID=

# Запасная постоянная ссылка в группу, если PRIVATE_CHANNEL_ID не задан (необязательно)
ACCESS_LINK=

# ===== Продажа =====

PRICE=1490
# Зачёркнутая «старая» цена в оффере (необязательно)
OLD_PRICE=

# Многоразовая ссылка на оплату (Paydex → Платёжные ссылки → Многоразовая). Можно задать и в «⚙️ Настройки».
# Кнопка «Оплатить по СБП» → «💳 Оплатить» (эта ссылка) и «✅ Я оплатил» (тебе приходит заявка на проверку).
PAYMENT_URL=

# Реквизиты для перевода, если ссылки на оплату нет. Перенос строки — \n.
# Если пусто и ссылки нет — бот просит написать в поддержку.
PAYMENT_DETAILS=

# Пользовательское соглашение и политика конфиденциальности (шаблон — docs/legal.py).
# Пусто — ссылки в «Информации» и строка про соглашение в оффере не показываются.
AGREEMENT_URL=
PRIVACY_URL=

# ===== Прочее =====

DB_PATH=litepdd_bot.db
QUESTIONS_PATH=data/questions.json
TIMEZONE=Europe/Moscow

# Множитель задержек дожимающих сообщений. 1 = как в сценарии.
# Для проверки поставь 0.005 — сообщения будут приходить примерно каждые 2 минуты.
FOLLOWUP_DELAY_SCALE=1
